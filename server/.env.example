DATABASE_URL=postgres://agegap:agegap@localhost:5432/agegap
JWT_SECRET=change-this-long-random-string
CLIENT_URL=http://localhost:5173
PORT=4000
# Optional
OPENAI_API_KEY=            # real text moderation; leave empty for the keyword fallback
REQUIRE_VERIFICATION=false # true = only admin-approved users appear in Discover
KEEP_SELFIES=false         # true = keep selfie files after approval (default: delete)
# Push notifications: run `npm run vapid` and paste the two keys here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email (Resend). Free plan: verify your own domain to email real users; onboarding@resend.dev only reaches your own account email.
RESEND_API_KEY=
MAIL_FROM=Tumblrr <no-reply@yourdomain.com>
# Phone (Twilio Verify). Leave empty in development: the code is printed to the server console and is always 000000.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
REQUIRE_PHONE=false  # true = phone must be verified before matching
# Redis: set when you run more than one API server (shared rate limits, presence, and Socket.IO)
REDIS_URL=
# Video moderation needs ffmpeg installed on the server and OPENAI_API_KEY set. Without a key, media is only allowed in development.
NEW_CHATS_PER_DAY=10  # new chats one person can start per day
